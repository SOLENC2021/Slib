rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper
    function isSignedIn() {
      return request.auth != null;
    }

    // Connection Test Document
    match /test/connection {
      allow get: if true;
    }

    // Users collection - open read and write for all users
    match /users/{userId} {
      allow read, write: if true;
    }

    // Files collection - completely open so anyone opening the link can view, search, and upload files
    match /files/{fileId} {
      allow read, write: if true;

      // Sub-collection for page OCR data
      match /pages/{pageNumber} {
        allow read, write: if true;
      }
    }

    // Settings collection
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Notes collection
    match /notes/{noteId} {
      allow read, write: if true;
    }
  }
}
