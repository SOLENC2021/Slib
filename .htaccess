# Tắt cache và buffer để hỗ trợ AI Stream gõ chữ thời gian thực
SetEnv no-gzip 1
SetEnv dont-vary 1

<IfModule mod_headers.c>
    Header set X-Accel-Buffering "no"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Rewrite all root/asset traffic into the compiled 'dist' directory
    RewriteCond %{REQUEST_URI} !^/dist/
    RewriteRule ^(.*)$ dist/$1 [L]

    # 2. Support React Router SPA fallback inside the 'dist' directory for clean client-side URLs
    RewriteCond %{DOCUMENT_ROOT}/dist/$1 !-f
    RewriteCond %{DOCUMENT_ROOT}/dist/$1 !-d
    RewriteRule ^dist/(.*)$ dist/index.html [L]
</IfModule>
